/* assets/style.qss — Clean Light Theme */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #f8f9fa;
    color: #212529;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
}

/* Labels and checkboxes must be transparent so they don't
   show a grey box over white parent backgrounds */
QLabel {
    background-color: transparent;
}

QCheckBox {
    background-color: transparent;
    spacing: 5px;
}

QRadioButton {
    background-color: transparent;
}

QGroupBox {
    background-color: transparent;
}

QMainWindow {
    background-color: #f0f2f5;
}

/* ── Splitter ────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #dee2e6;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #2563eb;
}

/* ── Sidebar ─────────────────────────────────────────────── */
#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #dee2e6;
}

QTabWidget#sidebarTabs::pane {
    border: none;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #ffffff;
    color: #6c757d;
    padding: 9px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 11px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
    background-color: #ffffff;
}

QTabBar::tab:hover:!selected {
    color: #495057;
    background-color: #f8f9fa;
}

/* ── Search box ──────────────────────────────────────────── */
QLineEdit#searchBox {
    background-color: #f8f9fa;
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 7px 10px;
    color: #212529;
    font-size: 12px;
}

QLineEdit#searchBox:focus {
    border: 1.5px solid #2563eb;
    background-color: #ffffff;
}

/* ── Category buttons ────────────────────────────────────── */
QPushButton#catBtn {
    background-color: #f8f9fa;
    color: #495057;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#catBtn:hover {
    background-color: #e9ecef;
    color: #212529;
    border-color: #ced4da;
}

QPushButton#catBtn:checked {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
}

/* ── Ticker list ─────────────────────────────────────────── */
QListWidget#tickerList {
    background-color: #ffffff;
    border: none;
    outline: none;
    font-size: 11px;
}

QListWidget#tickerList::item {
    padding: 5px 10px;
    border-radius: 4px;
    color: #212529;
    border-bottom: 1px solid #f1f3f5;
}

QListWidget#tickerList::item:selected {
    background-color: #e8f0fe;
    color: #1d4ed8;
}

QListWidget#tickerList::item:hover:!selected {
    background-color: #f8f9fa;
}

/* ── Add / Remove buttons ────────────────────────────────── */
QPushButton#addBtn {
    background-color: #ffffff;
    color: #16a34a;
    border: 1px solid #16a34a;
    border-radius: 5px;
    padding: 6px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#addBtn:hover {
    background-color: #16a34a;
    color: #ffffff;
}

QPushButton#removeBtn {
    background-color: #ffffff;
    color: #dc2626;
    border: 1px solid #dc2626;
    border-radius: 5px;
    padding: 6px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#removeBtn:hover {
    background-color: #dc2626;
    color: #ffffff;
}

/* ── Opportunity tab ─────────────────────────────────────── */
QLabel#infoLabel {
    color: #6c757d;
    font-size: 10px;
    padding: 4px 2px;
}

QLabel#statusLabel {
    color: #6c757d;
    font-size: 10px;
    padding: 2px 4px;
}

QPushButton#scanBtn {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 9px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#scanBtn:hover {
    background-color: #1d4ed8;
}

QPushButton#scanBtn:disabled {
    background-color: #ced4da;
    color: #6c757d;
}

QProgressBar#scanProgress {
    background-color: #e9ecef;
    border: none;
    border-radius: 3px;
    height: 5px;
    text-align: center;
    font-size: 9px;
    color: transparent;
}

QProgressBar#scanProgress::chunk {
    background-color: #2563eb;
    border-radius: 3px;
}

/* ── Toolbar ─────────────────────────────────────────────── */
QFrame#toolbar {
    background-color: #ffffff;
    border-bottom: 1px solid #dee2e6;
}

QLabel#tickerLabel {
    color: #212529;
    font-size: 14px;
    font-weight: 700;
}

QLabel#toolbarLabel {
    color: #6c757d;
    font-size: 11px;
}

QFrame#toolbarSep {
    color: #dee2e6;
    max-width: 1px;
    margin: 8px 2px;
}

QComboBox#periodCombo {
    background-color: #f8f9fa;
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 4px 10px;
    color: #212529;
    font-size: 11px;
    font-weight: 500;
    min-width: 55px;
}

QComboBox#periodCombo:hover {
    border-color: #2563eb;
}

QComboBox#periodCombo::drop-down {
    border: none;
    width: 18px;
}

QComboBox#periodCombo QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    selection-background-color: #e8f0fe;
    selection-color: #1d4ed8;
    color: #212529;
    outline: none;
}

QCheckBox#smaCheck {
    background-color: transparent;
    color: #495057;
    font-size: 11px;
    spacing: 4px;
    font-weight: 500;
}

QCheckBox#smaCheck::indicator {
    width: 14px;
    height: 14px;
    border: 1.5px solid #ced4da;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox#smaCheck::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}

QPushButton#refreshBtn {
    background-color: #f8f9fa;
    color: #495057;
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#refreshBtn:hover {
    background-color: #e9ecef;
    border-color: #adb5bd;
    color: #212529;
}

/* ── Stats panel ─────────────────────────────────────────── */
#StatsPanel {
    background-color: #ffffff;
    border-top: 1px solid #dee2e6;
}

QLabel#statLabel {
    color: #6c757d;
    font-size: 10px;
    font-weight: 400;
}

QLabel#statValue {
    color: #212529;
    font-size: 11px;
    font-weight: 600;
}

QFrame#statSep {
    color: #dee2e6;
    max-width: 1px;
    margin: 6px 4px;
}

/* ── Right panel ─────────────────────────────────────────── */
#rightPanel {
    background-color: #f8f9fa;
}

/* ── Scrollbars ──────────────────────────────────────────── */
QScrollBar:vertical {
    background: #f8f9fa;
    width: 7px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #ced4da;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #adb5bd;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #f8f9fa;
    height: 7px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #ced4da;
    border-radius: 3px;
    min-width: 20px;
}
