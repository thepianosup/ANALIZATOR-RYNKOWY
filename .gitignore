# ── System ──────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Środowisko wirtualne (odtwarzalne: python -m venv .venv) ────────
.venv/
venv/
env/

# ── Edytor / IDE ────────────────────────────────────────────────────
.vscode/
.idea/

# ── Build aplikacji (odtwarzalny: pyinstaller "Analizator Rynkowy.spec") ──
build/
dist/

# ── Logi i pliki tymczasowe ─────────────────────────────────────────
*.log

# ── Dokumenty referencyjne (nie kopiujemy do repozytorium) ──────────
*.pdf

# Uwaga: icon.png, icon.icns oraz plik "Analizator Rynkowy.spec" są
# celowo w repozytorium — są potrzebne do zbudowania aplikacji .app.
# Danych użytkownika (portfel, watchlista, klucz AI) program nie trzyma
# w tym folderze, tylko w ~/.analizator_rynkowy — dlatego nie ma ich
# w tym pliku.
